#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/ {
CONFIG_ZMK_KSCAN_DEBOUNCE_PRESS_MS=1
CONFIG_ZMK_KSCAN_DEBOUNCE_RELEASE_MS=15
    behaviors {
        i_uml_a: i_uml_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp DQT>
                , <&macro_tap &kp A>
                ;
        };
        i_uml_o: i_uml_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp DQT>
                , <&macro_tap &kp O>
                ;
        };
        i_dqt: i_dqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp DQT>
                , <&macro_tap &kp SPACE>
                ;
        };
        i_sqt: i_sqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp SQT>
                , <&macro_tap &kp SPACE>
                ;
        };
        i_grave: i_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp GRAVE>
                , <&macro_tap &kp SPACE>
                ;
        };
        i_tilde: i_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp TILDE>
                , <&macro_tap &kp SPACE>
                ;
        };
        i_caret: i_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp CARET>
                , <&macro_tap &kp SPACE>
                ;
        };

        spc4: spc4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp SPACE &kp SPACE &kp SPACE &kp SPACE>
                ;
        };
        bs0t0: bs0t0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &bt BT_SEL 0>
                , <&macro_tap &to 0>
                ;
        };
        bs1t0: bs1t0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &bt BT_SEL 1>
                , <&macro_tap &to 0>
                ;
        };
        bs2t0: bs2t0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &bt BT_SEL 2>
                , <&macro_tap &to 0>
                ;
        };
        bs3t0: bs3t0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &bt BT_SEL 3>
                , <&macro_tap &to 0>
                ;
        };

        bs4t0: bs24t0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &bt BT_SEL 4>
                , <&macro_tap &to 0>
                ;
        };
        ot_t0: ot_t0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &out OUT_TOG>
                , <&macro_tap &to 0>
                ;
        };
        bt_clr_t0: bt_clr_t0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &bt BT_CLR>
                , <&macro_tap &to 0>
                ;
        };
        }
        to0: to0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_tap &to 0>
                ;
        };

    };
};

/ {
    keymap {
        compatible =  "zmk,keymap" ;
/*
        qwerty {
// -------------------------------------------------------------------------------------------------------------------------
// | ESC   |  1    |  2  |  3  |  4  |  5  |                   ---                |  6  |  7  |  8   |  9   |  0   |   =   |
// | TAB   |  Q    |  W  |  E  |  R  |  T  |   [   |           ---        |  ]    |  Y  |  U  |  I   |  O   |  P   |   -   |
// | ESC   |  A    |  S  |  D  |  f  |  G  | DEL   |           ---        | RET   |  H  |  J  |  K   |  L   |  :   | SHIFT |
// | SHIFT |  Z    |  X  |  C  |  V  |  B  | PG_UP | PG_DOWN | --- | HOME | END   |  N  |  M  |  ,   |  .   |  UP  |   '   |
// | CRTL  | PSCRN | GUI | ALT |   LOWER   | RET   | DEL     | --- | BKSP | SPACE |   RAISE   | CTRL | LEFT | DOWN | RIGHT |
            bindings = <
   &kp ESC    &kp N1     &kp N2    &kp N3  &kp N4   &kp N5                                           &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp EQUAL
   &kp TAB    &kp Q      &kp W     &kp E   &kp R    &kp T  &kp LBKT                        &kp RBKT  &kp Y   &kp U   &kp I      &kp O     &kp P     &kp MINUS
   &kp ESC    &kp A      &kp S     &kp D   &kp F    &kp G  &kp DEL                         &kp RET   &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
   &kp LSHFT  &kp Z      &kp X     &kp C   &kp V    &kp B  &kp PG_UP  &kp PG_DN  &kp HOME  &kp END   &kp N   &kp M   &kp COMMA  &kp DOT   &kp UP    &kp RSHFT
   &kp LCTRL  &kp PSCRN  &kp LGUI  &kp LALT     &mo 1      &kp RET    &kp DEL    &kp SPACE &kp SPACE       &mo 2     &kp LCTRL  &kp LEFT  &kp DOWN  &kp RIGHT
            >;

        };
*/
        colemak {
// ---------------------------------------------------------------------------------------------------------------------------
// | ESC   |  1    |  2  |  3  |  4  |  5  |                   ---                 |  6  |  7  |  8   |  9   |  0    |   =   |
// | TAB   |  Q    |  W  |  F  |  P  |  G  | [     |           ---         | ]     |  J  |  L  |  U   |  Y   |  ;    |   -   |
// | ESC   |  A    |  R  |  S  |  T  |  D  | DEL   |           ---         | RET   |  H  |  N  |  E   |  I   |  O    |   '   |
// | SHIFT |  Z    |  X  |  C  |  V  |  B  | PG_UP | PG_DOWN | --- | HOME  | END   |  K  |  M  |  ,   |  .   |  UP   | SHIFT |
// | CRTL  | PSCRN | GUI | ALT |   LOWER   | BKSP  | DEL     | --- | SPACE | SPACE |   RAISE   | CTRL | LEFT | DOWN  | RIGHT |
            bindings = <
   &kp ESC    &kp N1     &kp N2    &kp N3  &kp N4   &kp N5                                            &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp EQUAL
   &kp TAB    &kp Q      &kp W     &kp F   &kp P    &kp G  &kp LBKT                         &kp RBKT  &kp J   &kp L   &kp U      &kp Y     &kp SEMI  &kp MINUS
   &kp ESC    &kp A      &kp R     &kp S   &kp T    &kp D  &kp DEL                          &kp RET   &kp H   &kp N   &kp E      &kp I     &kp O     &kp SQT
   &kp LSHFT  &kp Z      &kp X     &kp C   &kp V    &kp B  &kp PG_UP  &kp PG_DN  &kp HOME   &kp END   &kp K   &kp M   &kp COMMA  &kp DOT   &kp UP    &kp RSHFT
   &kp LCTRL  &kp PSCRN  &kp LGUI  &kp LALT     &mo 1      &kp BKSP   &kp DEL    &kp SPACE  &kp SPACE       &mo 2     &kp LCTRL  &kp LEFT  &kp DOWN  &kp RIGHT
            >;

        };

        lower {
// --------------------------------------------------------------------------------------------------------------------------
// | ESC   |   1   |  2  |  3  |  4  |  5  |                   ---                 |  6  |  7  |  8   |  9   |  0   |   +   |
// | TAB   |   !   |  @  |  #  |  $  |  %  | [     |           ---         | ]     |  ^  |  &  |  *   |  (   |  )   |   -   |
// | ESC   |   Ä   |  `  |  '  |  "  | 4sp | DEL   |           ---         | RET   | ESC |  ?  |  ,   |  .   |  Ö   |   '   |
// | SHIFT |   Z   |  X  |  C  |  V  |  B  | PG_UP | PG_DOWN | --- | HOME  | END   |  !  |  :  | HOME | END  |  UP  | SHIFT |
// | CRTL  | PSCRN | GUI | ALT |   LOWER   | BKSP  | DEL     | --- | SPACE | SPACE |   RAISE   | CTRL | LEFT | DOWN  | RIGHT |
            bindings = <
   &trans   &trans    &trans     &trans    &trans    &trans                                        &trans     &trans     &trans     &trans    &trans     &trans
   &trans   &kp EXCL  &kp AT     &kp HASH  &kp DLLR  &kp PRCNT  &trans                     &trans  &i_caret   &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR   &trans
   &trans   &i_uml_a  &i_grave   &i_sqt    &i_dqt    &spc4      &trans                     &trans  &kp ESC    &kp QMARK  &kp COMMA  &kp DOT   &i_uml_o   &trans
   &trans   &trans    &trans     &trans    &trans    &trans     &trans   &trans   &trans   &trans  &kp EXCL   &kp COLON  &kp HOME   &kp END   &trans     &trans
   &trans   &trans    &trans     &trans         &trans          &kp DEL  &kp DEL  &kp RET  &kp RET          &to 3        &trans     &trans    &trans     &trans
            >;
        };

        raise {
// --------------------------------------------------------------------------------------------------------------------------
// | ESC   |  1    |  2  |  3  |  4  |  5  |                   ---                 |  6  |  7  |  8   |  9   |  0   |   +   |
// | TAB   |  >    |  )  |  ]  |  }  |  \  | [     |           ---         | ]     |  ~  |  +  |  -   |  |   |  ;   |   '   |
// | ESC   |  <    |  (  |  [  |  {  |  /  | DEL   |           ---         | RET   | ESC |  =  |  _   |  $   |  :   |   '   |
// | SHIFT |  Z    |  X  |  C  |  V  |  B  | PG_UP | PG_DOWN | --- | HOME  | END   |  !  |  :  | HOME | END  |  UP  | SHIFT |
// | CRTL  | PSCRN | GUI | ALT |   TOADJ   | BKSP  | DEL     | --- | SPACE | SPACE |   RAISE   | CTRL | LEFT | DOWN | RIGHT |
            bindings = <
   &trans  &trans  &trans    &trans    &trans    &trans                                       &trans     &trans     &trans     &trans    &trans     &trans
   &trans  &kp GT  &kp RPAR  &kp RBKT  &kp RBRC  &kp BSLH  &trans                     &trans  &i_tilde   &kp PLUS   &kp MINUS  &kp PIPE  &kp SEMI   &trans
   &trans  &kp LT  &kp LPAR  &kp LBKT  &kp LBRC  &kp FSLH  &trans                     &trans  &kp ESC    &kp EQUAL  &kp UNDER  &kp DLLR  &kp COLON  &trans
   &trans  &trans  &trans    &trans    &trans    &trans    &trans   &trans   &trans   &trans  &kp EXCL   &kp COLON  &kp HOME   &kp END   &kp UP     &trans
   &trans  &trans  &trans    &trans          &to 3         &kp DEL  &kp DEL  &kp RET  &kp RET        &trans         &trans     &trans    &trans     &trans
            >;
       };

        adjust {
// ------------------------------------------------------------------------------------------------------------------------------
// | F12    | F1    | F2  | F3   | F4  | F5  |                     ---                 |  F6  |  F7 |  F8 |  F9  |  F10 |  F11  |
// | TAB    | BT1   | BT2 | BT3  | BT4 | BT5 | (       |           ---         |  )    |  (   |  7  |  8  |  9   |  +   |   -   |
// | ESC    | ^     | `   | '    | "   | ~   | DEL     |           ---         | RET   |  ,   |  4  |  5  |  6   |  *   |   /   |
// | SHIFT  | Z     | X   | C    | V   | B   | OUT TGL | BT CLR  | --- | HOME  | END   |  RET |  1  |  2  |  3   |  UP  | SHIFT |
// | CRTL   | PSCRN | GUI | ALT  |   TODEF   | BKSP    | DEL     | --- | SPACE | SPACE |    TODEF   |  0  | LEFT | DOWN | RIGHT |
            bindings = <
   &to0 F12  &to0 F1     &to0 F2     &to0 F3   &to0 F4   &to0 F5                                             &to0 F6    &to0 F7  &to0 F8  &to0 F9   &to0 F10      &to0 F11
   &trans    &bs0t0      &bs1t0      &bs2t0    &bs3t0    &bs4t0      &trans                        &kp LPAR  &kp RPAR   &kp N7   &kp N8   &kp N9    &kp PLUS      &kp MINUS
   &trans    &to0 CARET  &to0 GRAVE  &to0 SQT  &to0 DQT  &to0 TILDE  &trans                        &trans    &kp COMMA  &kp N4   &kp N5   &kp N6    &kp ASTERISK  &kp FSLH
   &trans    &trans      &trans      &trans    &trans    &trans      &ot_t0    &bt_clr_t0  &trans  &trans    &kp RET    &kp N1   &kp N2   &kp N3    &kp UP        &trans
   &trans    &trans      &trans      &trans         &to 0            &trans    &trans      &trans  &trans        &to 0           &kp N0   &kp LEFT  &kp DOWN      &kp RIGHT
            >;
        };
    };
};
